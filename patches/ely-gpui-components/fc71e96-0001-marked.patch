 /// Text left between images, unless it is blank.
+
+/// `==marked==` text: the markers leave the drawing, the run is a `Mark`.
+fn marked(mut inline: Inline) -> Inline {
+    let text = inline.text.clone();
+    // Code and math draw their own text: `==` inside them stays as written.
+    let verbatim: Vec<Range<usize>> = (inline.styles.iter())
+        .filter(|(_, style)| matches!(style, Style::Code | Style::Math))
+        .map(|(range, _)| range.clone())
+        .collect();
+    let literal = |at: usize| verbatim.iter().any(|range| range.contains(&at));
+    let mut pairs = Vec::new();
+    let mut at = 0;
+    while let Some(found) = text[at..].find("==") {
+        let open = at + found;
+        let Some(tail) = text[open + 2..].find("==") else {
+            break;
+        };
+        let close = open + 2 + tail;
+        match (close > open + 2, literal(open)) {
+            (true, false) => pairs.push((open, close)),
+            (true, true) => {}
+            (false, _) => {}
+        }
+        at = if literal(open) { open + 2 } else { close + 2 };
+    }
+    if pairs.is_empty() {
+        return inline;
+    }
+    let removed: Vec<(usize, usize)> = pairs
+        .iter()
+        .flat_map(|(open, close)| [(*open, *open + 2), (*close, *close + 2)])
+        .collect();
+    let shift = |offset: usize| {
+        let mut shift = 0;
+        for (start, end) in &removed {
+            if offset <= *start {
+                break;
+            }
+            if offset >= *end {
+                shift += end - start;
+            } else {
+                return start - shift;
+            }
+        }
+        offset - shift
+    };
+    let mut drawn = String::with_capacity(text.len());
+    let mut old = 0;
+    for (open, close) in &pairs {
+        drawn.push_str(&text[old..*open]);
+        drawn.push_str(&text[open + 2..*close]);
+        old = close + 2;
+    }
+    drawn.push_str(&text[old..]);
+    let marked = pairs
+        .iter()
+        .map(|(open, close)| (shift(open + 2)..shift(*close), Style::Mark));
+    inline.styles = (inline.styles.iter())
+        .map(|(range, style)| (shift(range.start)..shift(range.end), *style))
+        .chain(marked)
+        .collect();
+    inline.links = (inline.links.iter())
+        .map(|(range, url)| (shift(range.start)..shift(range.end), url.clone()))
+        .collect();
+    inline.sources = (inline.sources.iter())
+        .map(|(at, span, escapes)| (shift(*at), span.clone(), *escapes))
+        .collect();
+    inline.text = drawn;
+    inline
+}

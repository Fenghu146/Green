+/// `✅`/`❌` draw as the green check and the red cross the export draws: no
+/// bundled face has the emoji, and the editor and the PDF must look alike.
+fn marks(inline: Inline) -> Inline {
+    if !inline.text.contains(['✅', '❌']) {
+        return inline;
+    }
+    let Inline {
+        text,
+        styles,
+        links,
+        sources,

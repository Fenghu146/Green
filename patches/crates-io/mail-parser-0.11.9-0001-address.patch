+// A local part quoted again, as RFC 5322 writes it.
+fn quote_local(local: &str) -> String {
+    let mut quoted = String::with_capacity(local.len() + 2);
+    quoted.push('"');
+    for ch in local.chars() {
+        if matches!(ch, '"' | '\\') {
+            quoted.push('\\');
+        }
+        quoted.push(ch);
+    }
+    quoted.push('"');
+    quoted
